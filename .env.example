# Copy this file to .env.local (and/or .env) and fill in real values.
# Never commit .env or .env.local — both are git-ignored.

# --- PostgreSQL (Supabase or any Postgres host) ---
# Pooled connection (pgbouncer) — used at runtime by lib/prisma.ts
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"

# Direct connection — used by prisma.config.ts for migrations (bypasses the pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# --- MapTiler (https://www.maptiler.com/) ---
# Powers geocoding autocomplete and Leaflet map tiles. Exposed to the browser bundle
# (NEXT_PUBLIC_ prefix), so use a key restricted to your domain.
NEXT_PUBLIC_MAPTILER_API_KEY="your-maptiler-api-key"

# --- Google Generative AI (Gemini) ---
# Powers destination enrichment (lib/gemini-enricher.ts) and the AI itinerary
# endpoint (app/api/ai-itinerary/route.ts). Server-only — do not prefix with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# Optional: additional keys (from separate Google accounts) for automatic fallback
# when the free tier's daily quota (20 requests/day/key) is exhausted. lib/gemini-client.ts
# tries these in order — KEY, then KEY_2, KEY_3, etc. — switching automatically on a
# quota/rate-limit error. Omit if you only have one key.
# GOOGLE_GENERATIVE_AI_API_KEY_2="your-second-gemini-api-key"
# GOOGLE_GENERATIVE_AI_API_KEY_3="your-third-gemini-api-key"

# --- Unsplash (https://unsplash.com/developers) ---
# Powers destination hero images (lib/image-provider.ts) for any destination not
# in the small curated fallback list. Free tier: 50 requests/hour. Server-only —
# do not prefix with NEXT_PUBLIC_. Falls back to a generic placeholder if omitted
# or if the request fails/rate-limits.
UNSPLASH_ACCESS_KEY="your-unsplash-access-key"
